<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.i9950.printer-app</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/i9950-printer-app</string>
    <string>server</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/tmp/i9950-printer-app.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/i9950-printer-app.err</string>
</dict>
</plist>
